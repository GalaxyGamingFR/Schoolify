// Schoolify data model — Phase 0.
// Modeled for all four roles (Student/Parent/Teacher/Admin) even though only
// Student paths are implemented through Phase 1-5. See roadmap.md Part 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase's pooled connection (DATABASE_URL, pgbouncer) doesn't support
  // the DDL migrations need — directUrl is the unpooled connection,
  // required only for `prisma migrate`. Not used at runtime.
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  PARENT
  TEACHER
  ADMIN
}

enum GuardianshipStatus {
  PENDING
  ACCEPTED
}

enum AssignmentType {
  READING
  PROJECT
  ESSAY
  EXAM
  QUIZ
  LAB
  HOMEWORK
  OTHER
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Every relation below that points at User now declares an explicit
// onDelete — found the hard way when a real account deletion in production
// crashed the Clerk `user.deleted` webhook with a foreign key violation on
// Assignment (Prisma/Postgres default FK behavior is RESTRICT, and none of
// these had ever specified otherwise). Personal data (assignments,
// enrollments, calendar events, activities, degree/application records,
// messages, blocks, reports, guardianship links) cascades away with the
// account; shared structures a deleted user merely had a role in (a
// Course they taught, a SchoolStaff seat) get SetNull instead so deleting
// one teacher's account doesn't take an entire class's course down with it.
model User {
  id          String   @id @default(cuid())
  clerkId     String   @unique
  email       String   @unique
  name        String
  role        Role     @default(STUDENT)
  dateOfBirth DateTime? // drives COPPA gating (Phase 6)
  // Null until the role-picker + (for students) date-of-birth step is
  // completed. The dashboard is the single choke point that checks this —
  // see roadmap.md Phase 6 — rather than every route re-checking it.
  onboardingCompletedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Student-side relations
  enrollments      Enrollment[]
  assignments      Assignment[]
  calendarEvents   CalendarEvent[]
  guardiansOfMe    Guardianship[]   @relation("StudentGuardianships")

  // Parent-side relations
  studentsIGuard   Guardianship[]   @relation("ParentGuardianships")

  // School-staff relations
  taughtCourses    Course[]         @relation("TaughtCourses")
  schoolStaffRoles SchoolStaff[]

  // Phase 9: University Portal & Degree Blueprint
  activities         Activity[]
  universityTargets  UniversityTarget[]
  degreeRequirements DegreeRequirement[]

  // Phase 8: Messaging & Study Networks
  conversations   ConversationParticipant[]
  sentMessages    Message[]                 @relation("SentMessages")
  filedReports    Report[]                  @relation("FiledReports")
  blockedUsers    Block[]                   @relation("BlockedByMe")
  blockedByUsers  Block[]                   @relation("BlockedMe")

  notifications Notification[]

  @@index([role])
}

model Guardianship {
  id        String             @id @default(cuid())
  parent    User               @relation("ParentGuardianships", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String
  student   User               @relation("StudentGuardianships", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  status    GuardianshipStatus @default(PENDING)
  createdAt DateTime           @default(now())

  @@unique([parentId, studentId])
  @@index([studentId])
}

model School {
  id        String   @id @default(cuid())
  name      String
  // Lowercase, no leading "@" (e.g. "lincolnhigh.edu"). Gates both staff
  // invites and student self-join: an account's own (Clerk-verified) email
  // must share this domain. See roadmap.md's school-onboarding phase for
  // why this is real verification of *an* inbox at the domain, not proof of
  // institutional authorization — that still needs a manual process.
  domain    String   @unique
  createdAt DateTime @default(now())

  terms   Term[]
  courses Course[]
  staff   SchoolStaff[]
}

enum SchoolRole {
  PRINCIPAL
  TEACHER
}

enum StaffStatus {
  INVITED
  ACTIVE
}

// A person's staff membership at one school. Deliberately separate from the
// global User.role (STUDENT/PARENT/TEACHER/ADMIN) rather than overloading
// it — someone can run a school and still use their own Student/Parent
// dashboard, so "am I school staff" shouldn't force a choice at onboarding.
model SchoolStaff {
  id        String      @id @default(cuid())
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  // Null until the invited email actually signs in and gets claimed
  // (claimSchoolInvites) — an invite can be sent to someone without a
  // Schoolify account yet.
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  email     String // lowercase-normalized; the claim key for INVITED rows
  role      SchoolRole
  status    StaffStatus @default(ACTIVE)
  createdAt DateTime    @default(now())

  @@unique([schoolId, email])
  @@index([userId])
}

model Term {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id])
  schoolId  String
  name      String // e.g. "Fall 2026"
  startDate DateTime
  endDate   DateTime

  courses Course[]

  @@index([schoolId])
}

model Course {
  id        String   @id @default(cuid())
  school    School?  @relation(fields: [schoolId], references: [id])
  schoolId  String?
  term      Term?    @relation(fields: [termId], references: [id])
  termId    String?
  name      String
  createdAt DateTime @default(now())

  // Set only for school-managed courses (a teacher created it under a
  // School) — null means a student's own self-tracked course, same as
  // every course before this phase. Ownership checks in courses.ts branch
  // on this: a self-tracked course is owned by any enrolled student (as
  // before), a school-managed one only by its teacher.
  teacher   User?    @relation("TaughtCourses", fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId String?
  // Set only alongside teacherId — students self-join with this code,
  // gated on their own email domain matching the School's.
  joinCode  String?  @unique

  enrollments    Enrollment[]
  assignments    Assignment[]
  gradeCategories GradeCategory[]
  conversation    Conversation?

  @@index([termId])
  @@index([teacherId])
}

model Enrollment {
  id        String   @id @default(cuid())
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  createdAt DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([courseId])
}

model Assignment {
  id               String           @id @default(cuid())
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  // Optional so quick-add can create an uncategorized task and the student
  // triages it into a course later — see roadmap.md Phase 1 quick-add flow.
  course           Course?          @relation(fields: [courseId], references: [id])
  courseId         String?
  title            String
  type             AssignmentType   @default(OTHER)
  status           AssignmentStatus @default(NOT_STARTED)
  priority         Priority         @default(MEDIUM)
  dueAt            DateTime
  estimatedMinutes Int?
  // Set when status transitions to DONE, cleared if unmarked — distinct
  // from updatedAt (which changes on any edit) so XP/streak calculations
  // aren't corrupted by unrelated edits to an already-done task.
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  gradeEntries GradeEntry[]

  @@index([userId, dueAt])
  @@index([courseId])
}

model GradeCategory {
  id              String   @id @default(cuid())
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId        String
  name            String // e.g. "Exams"
  weight          Float // percentage points, e.g. 40 for 40%
  dropLowestN     Int      @default(0)
  curveAdjustment Float    @default(0) // flat percentage points added after averaging

  gradeEntries GradeEntry[]

  @@index([courseId])
}

model GradeEntry {
  id           String         @id @default(cuid())
  category     GradeCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId   String
  assignment   Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  assignmentId String?
  label        String
  pointsEarned Float
  pointsPossible Float
  createdAt    DateTime       @default(now())

  @@index([categoryId])
}

model CalendarEvent {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  startsAt  DateTime
  endsAt    DateTime?
  location  String?
  createdAt DateTime @default(now())

  @@index([userId, startsAt])
}

enum OpportunitySubject {
  STEM
  MATH
  SCIENCE
  COMPUTER_SCIENCE
  ENGINEERING
  BUSINESS
  WRITING
  DEBATE
  ARTS
  GENERAL
}

enum PrizeTier {
  RECOGNITION
  SMALL
  MEDIUM
  LARGE
  UNKNOWN
}

// Read-only reference data — manually curated, no user relation. See
// roadmap.md Phase 7 for the "don't fabricate deadlines/prizes" policy
// behind deadlineNote/prizeNote being free text rather than exact fields.
model Opportunity {
  id                   String             @id @default(cuid())
  title                String
  organization         String
  description          String
  url                  String
  subject              OpportunitySubject
  // Added in Phase 9 as the "scholarship finder": every one of the 47
  // Phase 7 entries is a competition/program, not a standalone scholarship
  // application, so a mutually-exclusive `type` enum would have mislabeled
  // them. This flags the ones that *award* scholarship money as a prize
  // (several already do — see prizeNote) instead of pretending they're
  // something else. See roadmap.md for why a real pure-scholarship list
  // (Coca-Cola Scholars, QuestBridge, etc.) is deferred rather than rushed.
  offersScholarship    Boolean            @default(false)
  minGrade             Int? // 1-12, null = no lower bound
  maxGrade             Int? // 1-12, null = no upper bound
  typicalDeadlineMonth Int? // 1-12, rough guide only — not a specific date
  deadlineNote         String // human-readable, honest about uncertainty
  prizeTier            PrizeTier          @default(UNKNOWN)
  prizeNote            String?
  createdAt            DateTime           @default(now())

  @@index([subject])
  @@index([prizeTier])
  @@index([offersScholarship])
}

// --- Phase 9: University Portal & Degree Blueprint (Module D + rest of B) ---
// Scope note: no invented real-world data anywhere below (no fabricated
// admissions criteria, no per-institution prerequisite trees) — everything
// here is self-authored by the student, the same trust boundary already
// used for grade categories/weights. See roadmap.md for what was
// deliberately left out and why.

enum ActivityCategory {
  CLUB
  VOLUNTEER
  LEADERSHIP
  SUMMER_PROGRAM
  AWARD
  WORK
  OTHER
}

/** One line of a student's portfolio/resume. */
model Activity {
  id           String           @id @default(cuid())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  title        String
  organization String?
  category     ActivityCategory @default(OTHER)
  role         String?
  description  String?
  hoursTotal   Int?
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId])
}

enum ApplicationStatus {
  RESEARCHING
  APPLYING
  SUBMITTED
  ACCEPTED
  REJECTED
  WAITLISTED
  DECLINED
}

/** A university/program a student is tracking — not matched against any admissions data, just self-entered. */
model UniversityTarget {
  id                  String            @id @default(cuid())
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  name                String
  applicationDeadline DateTime?
  status              ApplicationStatus @default(RESEARCHING)
  notes               String?
  createdAt           DateTime          @default(now())

  tasks ApplicationTask[]

  @@index([userId])
}

/** One checklist item (essay, recommendation letter, test score, transcript request, ...) under a target. */
model ApplicationTask {
  id       String           @id @default(cuid())
  target   UniversityTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  targetId String
  title    String
  done     Boolean          @default(false)
  dueDate  DateTime?
  createdAt DateTime        @default(now())

  @@index([targetId])
}

/**
 * A self-authored degree requirement, not a real institution's official
 * curriculum — nobody has that data. `requiresId` models a single
 * prerequisite link (not a full graph) on purpose: a real "visual
 * prerequisite tree" needs a graph-editing UI that can't be verified
 * without live browser testing in this environment, so it's a simple
 * "blocked by one other requirement" relation instead of a DAG.
 */
model DegreeRequirement {
  id               String   @id @default(cuid())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  label            String // e.g. "General Education — English"
  category         String? // free-text grouping, e.g. "Core", "Major", "Elective"
  creditsRequired  Float
  creditsCompleted Float    @default(0)
  notes            String?

  requires   DegreeRequirement?  @relation("Prereq", fields: [requiresId], references: [id])
  requiresId String?
  blockedBy  DegreeRequirement[] @relation("Prereq")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([requiresId])
}

// --- Phase 8: Messaging & Study Networks (Module E) ---
// Scope note: text messaging only — no voice, whiteboards, or flashcard
// decks (CLAUDE.md's aspirational Module E description goes further than
// roadmap.md's actual Phase 8 checklist, which is the source of truth for
// build order; voice is explicitly "(maybe)" there). Transport is
// short-interval client polling, not a WebSocket/Realtime push — see
// roadmap.md for why: real push via Supabase Realtime needs Postgres RLS
// wired to Clerk-issued JWTs (a nontrivial auth integration this pass
// doesn't attempt), and Vercel Functions WebSockets can't be verified
// end-to-end without live browser testing this environment doesn't have.
// All authorization stays in the same Prisma/server-action layer as every
// other feature, not delegated to database-level policies.

enum ConversationType {
  DIRECT
  GROUP
  COURSE
}

model Conversation {
  id        String           @id @default(cuid())
  type      ConversationType
  // User-chosen for GROUP; null for DIRECT (derived from the other
  // participant) and COURSE (derived from Course.name).
  name      String?
  // Only set for type=COURSE — membership for these is derived live from
  // Course enrollments/teacherId (roster changes take effect immediately,
  // no participant-row sync needed), so COURSE conversations don't use
  // ConversationParticipant at all.
  course    Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String?          @unique
  createdAt DateTime         @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([type])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  // Soft delete on moderation removal — keeps the Report's history intact
  // instead of hard-deleting evidence of what was reported.
  deletedAt      DateTime?

  reports Report[]

  @@index([conversationId, createdAt])
}

enum ReportStatus {
  OPEN
  RESOLVED_REMOVED
  RESOLVED_DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  message    Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId  String
  reporter   User         @relation("FiledReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  @@index([status])
  @@index([messageId])
}

/** One-directional: blockerId no longer sees blockedId's messages and can't start a new DM with them. */
model Block {
  id        String   @id @default(cuid())
  blocker   User     @relation("BlockedByMe", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User     @relation("BlockedMe", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// --- Notifications ---
// Created server-side at the handful of points where something happens
// *to* a user because of someone else's action (a message arrives, a
// guardian link request needs a response) -- not a generic pub/sub system,
// and not covering time-based events (assignment due soon, grade trend
// alerts) since those need a scheduled job this pass doesn't add. In-app
// only, polled same as messages (see roadmap.md Phase 8 note on why
// polling instead of a push transport).
enum NotificationType {
  MESSAGE
  GUARDIANSHIP_REQUEST
  GUARDIANSHIP_ACCEPTED
  SCHOOL_INVITE
  BROADCAST
}

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  title     String
  body      String?
  // Where clicking the notification should take you (e.g. "/messages/abc").
  link      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}
