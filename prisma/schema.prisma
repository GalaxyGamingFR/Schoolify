// Schoolify data model — Phase 0.
// Modeled for all four roles (Student/Parent/Teacher/Admin) even though only
// Student paths are implemented through Phase 1-5. See roadmap.md Part 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase's pooled connection (DATABASE_URL, pgbouncer) doesn't support
  // the DDL migrations need — directUrl is the unpooled connection,
  // required only for `prisma migrate`. Not used at runtime.
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  PARENT
  TEACHER
  ADMIN
}

enum GuardianshipStatus {
  PENDING
  ACCEPTED
}

enum AssignmentType {
  READING
  PROJECT
  ESSAY
  EXAM
  QUIZ
  LAB
  HOMEWORK
  OTHER
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id          String   @id @default(cuid())
  clerkId     String   @unique
  email       String   @unique
  name        String
  role        Role     @default(STUDENT)
  dateOfBirth DateTime? // drives COPPA gating (Phase 6)
  // Null until the role-picker + (for students) date-of-birth step is
  // completed. The dashboard is the single choke point that checks this —
  // see roadmap.md Phase 6 — rather than every route re-checking it.
  onboardingCompletedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Student-side relations
  enrollments      Enrollment[]
  assignments      Assignment[]
  calendarEvents   CalendarEvent[]
  guardiansOfMe    Guardianship[]   @relation("StudentGuardianships")

  // Parent-side relations
  studentsIGuard   Guardianship[]   @relation("ParentGuardianships")

  // School-staff relations
  taughtCourses    Course[]         @relation("TaughtCourses")
  schoolStaffRoles SchoolStaff[]

  // Phase 9: University Portal & Degree Blueprint
  activities         Activity[]
  universityTargets  UniversityTarget[]
  degreeRequirements DegreeRequirement[]

  @@index([role])
}

model Guardianship {
  id        String             @id @default(cuid())
  parent    User               @relation("ParentGuardianships", fields: [parentId], references: [id])
  parentId  String
  student   User               @relation("StudentGuardianships", fields: [studentId], references: [id])
  studentId String
  status    GuardianshipStatus @default(PENDING)
  createdAt DateTime           @default(now())

  @@unique([parentId, studentId])
  @@index([studentId])
}

model School {
  id        String   @id @default(cuid())
  name      String
  // Lowercase, no leading "@" (e.g. "lincolnhigh.edu"). Gates both staff
  // invites and student self-join: an account's own (Clerk-verified) email
  // must share this domain. See roadmap.md's school-onboarding phase for
  // why this is real verification of *an* inbox at the domain, not proof of
  // institutional authorization — that still needs a manual process.
  domain    String   @unique
  createdAt DateTime @default(now())

  terms   Term[]
  courses Course[]
  staff   SchoolStaff[]
}

enum SchoolRole {
  PRINCIPAL
  TEACHER
}

enum StaffStatus {
  INVITED
  ACTIVE
}

// A person's staff membership at one school. Deliberately separate from the
// global User.role (STUDENT/PARENT/TEACHER/ADMIN) rather than overloading
// it — someone can run a school and still use their own Student/Parent
// dashboard, so "am I school staff" shouldn't force a choice at onboarding.
model SchoolStaff {
  id        String      @id @default(cuid())
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  // Null until the invited email actually signs in and gets claimed
  // (claimSchoolInvites) — an invite can be sent to someone without a
  // Schoolify account yet.
  user      User?       @relation(fields: [userId], references: [id])
  userId    String?
  email     String // lowercase-normalized; the claim key for INVITED rows
  role      SchoolRole
  status    StaffStatus @default(ACTIVE)
  createdAt DateTime    @default(now())

  @@unique([schoolId, email])
  @@index([userId])
}

model Term {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id])
  schoolId  String
  name      String // e.g. "Fall 2026"
  startDate DateTime
  endDate   DateTime

  courses Course[]

  @@index([schoolId])
}

model Course {
  id        String   @id @default(cuid())
  school    School?  @relation(fields: [schoolId], references: [id])
  schoolId  String?
  term      Term?    @relation(fields: [termId], references: [id])
  termId    String?
  name      String
  createdAt DateTime @default(now())

  // Set only for school-managed courses (a teacher created it under a
  // School) — null means a student's own self-tracked course, same as
  // every course before this phase. Ownership checks in courses.ts branch
  // on this: a self-tracked course is owned by any enrolled student (as
  // before), a school-managed one only by its teacher.
  teacher   User?    @relation("TaughtCourses", fields: [teacherId], references: [id])
  teacherId String?
  // Set only alongside teacherId — students self-join with this code,
  // gated on their own email domain matching the School's.
  joinCode  String?  @unique

  enrollments    Enrollment[]
  assignments    Assignment[]
  gradeCategories GradeCategory[]

  @@index([termId])
  @@index([teacherId])
}

model Enrollment {
  id        String   @id @default(cuid())
  student   User     @relation(fields: [studentId], references: [id])
  studentId String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  createdAt DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([courseId])
}

model Assignment {
  id               String           @id @default(cuid())
  user             User             @relation(fields: [userId], references: [id])
  userId           String
  // Optional so quick-add can create an uncategorized task and the student
  // triages it into a course later — see roadmap.md Phase 1 quick-add flow.
  course           Course?          @relation(fields: [courseId], references: [id])
  courseId         String?
  title            String
  type             AssignmentType   @default(OTHER)
  status           AssignmentStatus @default(NOT_STARTED)
  priority         Priority         @default(MEDIUM)
  dueAt            DateTime
  estimatedMinutes Int?
  // Set when status transitions to DONE, cleared if unmarked — distinct
  // from updatedAt (which changes on any edit) so XP/streak calculations
  // aren't corrupted by unrelated edits to an already-done task.
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  gradeEntries GradeEntry[]

  @@index([userId, dueAt])
  @@index([courseId])
}

model GradeCategory {
  id              String   @id @default(cuid())
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId        String
  name            String // e.g. "Exams"
  weight          Float // percentage points, e.g. 40 for 40%
  dropLowestN     Int      @default(0)
  curveAdjustment Float    @default(0) // flat percentage points added after averaging

  gradeEntries GradeEntry[]

  @@index([courseId])
}

model GradeEntry {
  id           String         @id @default(cuid())
  category     GradeCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId   String
  assignment   Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  assignmentId String?
  label        String
  pointsEarned Float
  pointsPossible Float
  createdAt    DateTime       @default(now())

  @@index([categoryId])
}

model CalendarEvent {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  startsAt  DateTime
  endsAt    DateTime?
  location  String?
  createdAt DateTime @default(now())

  @@index([userId, startsAt])
}

enum OpportunitySubject {
  STEM
  MATH
  SCIENCE
  COMPUTER_SCIENCE
  ENGINEERING
  BUSINESS
  WRITING
  DEBATE
  ARTS
  GENERAL
}

enum PrizeTier {
  RECOGNITION
  SMALL
  MEDIUM
  LARGE
  UNKNOWN
}

// Read-only reference data — manually curated, no user relation. See
// roadmap.md Phase 7 for the "don't fabricate deadlines/prizes" policy
// behind deadlineNote/prizeNote being free text rather than exact fields.
model Opportunity {
  id                   String             @id @default(cuid())
  title                String
  organization         String
  description          String
  url                  String
  subject              OpportunitySubject
  // Added in Phase 9 as the "scholarship finder": every one of the 47
  // Phase 7 entries is a competition/program, not a standalone scholarship
  // application, so a mutually-exclusive `type` enum would have mislabeled
  // them. This flags the ones that *award* scholarship money as a prize
  // (several already do — see prizeNote) instead of pretending they're
  // something else. See roadmap.md for why a real pure-scholarship list
  // (Coca-Cola Scholars, QuestBridge, etc.) is deferred rather than rushed.
  offersScholarship    Boolean            @default(false)
  minGrade             Int? // 1-12, null = no lower bound
  maxGrade             Int? // 1-12, null = no upper bound
  typicalDeadlineMonth Int? // 1-12, rough guide only — not a specific date
  deadlineNote         String // human-readable, honest about uncertainty
  prizeTier            PrizeTier          @default(UNKNOWN)
  prizeNote            String?
  createdAt            DateTime           @default(now())

  @@index([subject])
  @@index([prizeTier])
  @@index([offersScholarship])
}

// --- Phase 9: University Portal & Degree Blueprint (Module D + rest of B) ---
// Scope note: no invented real-world data anywhere below (no fabricated
// admissions criteria, no per-institution prerequisite trees) — everything
// here is self-authored by the student, the same trust boundary already
// used for grade categories/weights. See roadmap.md for what was
// deliberately left out and why.

enum ActivityCategory {
  CLUB
  VOLUNTEER
  LEADERSHIP
  SUMMER_PROGRAM
  AWARD
  WORK
  OTHER
}

/** One line of a student's portfolio/resume. */
model Activity {
  id           String           @id @default(cuid())
  user         User             @relation(fields: [userId], references: [id])
  userId       String
  title        String
  organization String?
  category     ActivityCategory @default(OTHER)
  role         String?
  description  String?
  hoursTotal   Int?
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId])
}

enum ApplicationStatus {
  RESEARCHING
  APPLYING
  SUBMITTED
  ACCEPTED
  REJECTED
  WAITLISTED
  DECLINED
}

/** A university/program a student is tracking — not matched against any admissions data, just self-entered. */
model UniversityTarget {
  id                  String            @id @default(cuid())
  user                User              @relation(fields: [userId], references: [id])
  userId              String
  name                String
  applicationDeadline DateTime?
  status              ApplicationStatus @default(RESEARCHING)
  notes               String?
  createdAt           DateTime          @default(now())

  tasks ApplicationTask[]

  @@index([userId])
}

/** One checklist item (essay, recommendation letter, test score, transcript request, ...) under a target. */
model ApplicationTask {
  id       String           @id @default(cuid())
  target   UniversityTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  targetId String
  title    String
  done     Boolean          @default(false)
  dueDate  DateTime?
  createdAt DateTime        @default(now())

  @@index([targetId])
}

/**
 * A self-authored degree requirement, not a real institution's official
 * curriculum — nobody has that data. `requiresId` models a single
 * prerequisite link (not a full graph) on purpose: a real "visual
 * prerequisite tree" needs a graph-editing UI that can't be verified
 * without live browser testing in this environment, so it's a simple
 * "blocked by one other requirement" relation instead of a DAG.
 */
model DegreeRequirement {
  id               String   @id @default(cuid())
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  label            String // e.g. "General Education — English"
  category         String? // free-text grouping, e.g. "Core", "Major", "Elective"
  creditsRequired  Float
  creditsCompleted Float    @default(0)
  notes            String?

  requires   DegreeRequirement?  @relation("Prereq", fields: [requiresId], references: [id])
  requiresId String?
  blockedBy  DegreeRequirement[] @relation("Prereq")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([requiresId])
}
